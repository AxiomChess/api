{
  "name": "@axiomchess/api",
  "version": "1.0.0",
  "private": true,
  "description": "Public HTTP API for AxiomChess (Hono on Node)",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "docs",
    "openapi",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json --pretty false",
    "build:deps": "node scripts/build-git-deps.mjs",
    "postinstall": "node scripts/build-git-deps.mjs",
    "lint": "eslint . && tsc -p tsconfig.json --noEmit --pretty false",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "migrate": "node dist/migrate-cli.js",
    "start": "node dist/serve.js"
  },
  "dependencies": {
    "@axiomchess/adapters": "github:AxiomChess/adapters#main",
    "@axiomchess/analyzer": "github:AxiomChess/analyzer#main",
    "@hono/node-server": "^2.1.6",
    "hono": "^4.13.16",
    "pg": "8.16.3",
    "redis": "5.10.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.19.1",
    "@types/pg": "8.15.5",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.4",
    "vitest": "^3.2.4"
  }
}
