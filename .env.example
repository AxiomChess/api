# AxiomChess API environment (placeholders only; copy to .env locally)
# Never commit real secrets.

# TCP port for the HTTP server (default 3000)
PORT=3000

# Bind address (default 0.0.0.0)
HOST=0.0.0.0

# Runtime environment label
NODE_ENV=development

# PostgreSQL connection string (required for migrations and persistence)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/axiomchess

# Days to retain stored PGN + analysis results (default 30)
ANALYSIS_RETENTION_DAYS=30

# Pepper for hashing API keys at rest (required when minting/verifying keys)
API_KEY_PEPPER=replace-with-long-random-string

# Optional Redis URL for the analysis job queue and rate-limit counters
# (in-process / in-memory fallback when unset)
REDIS_URL=
